# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Supabase API endpoint (the Kong gateway, NOT the raw Postgres host).
SUPABASE_URL=https://supa.elixlab.nl

# JWT used by PostgREST and Realtime. Mint with the vectorizer's
# scripts/mint_jwt.py — or just reuse the same JWT you already minted for
# the vectorizer; both workers run as the `worker_external` role.
SUPABASE_KEY=replace-me

# Optional overrides.
# WORKER_KIND=rerank
# ALGORITHM=elas_h3              # default if the task's params.model is absent
# SAFETY_POLL_SECONDS=30
#
# Classifier hyperparameters (C, max_iter, balance_ratio) are NOT env vars —
# they're properties of the algorithm and live in ALGORITHMS{} in worker.py.
# To add or tune an algorithm, edit that registry.
