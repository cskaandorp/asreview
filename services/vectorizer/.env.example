# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Supabase API endpoint (the Kong gateway, NOT the raw Postgres host).
SUPABASE_URL=https://supa.elixlab.nl

# JWT used by PostgREST and Realtime. Mint it with scripts/mint_jwt.py:
#
#     SUPABASE_JWT_SECRET='<jwt-secret>' python scripts/mint_jwt.py
#
# Where to find the JWT secret (self-hosted Supabase):
#   It is NOT shown in Supabase Studio for self-hosted deployments. Instead,
#   SSH into the server running Supabase (Patrick) and read it from the
#   docker-compose .env file:
#
#       ssh patrick
#       grep '^JWT_SECRET=' ~/supabase/docker/.env
#       # (path may differ; try: sudo find / -name '.env' -path '*supabase*')
#
#   The value is a 40+ char random string (NOT a JWT itself). Treat it as a
#   master key — never put it in the worker's environment.
#
# Alternative for quick bring-up: paste the service_role key (also in
# Supabase's .env) here directly. Works but gives god-mode DB access; switch
# to a minted worker_external JWT before anything real.
SUPABASE_KEY=replace-me

# Optional overrides.
# WORKER_KIND=vectorize
# MODEL_NAME=mxbai
# HF_MODEL_ID=mixedbread-ai/mxbai-embed-large-v1
# ENCODE_BATCH_SIZE=32
# SAFETY_POLL_SECONDS=30
# SIMULATED_WORK_SECONDS=0
# DRY_RUN=false
